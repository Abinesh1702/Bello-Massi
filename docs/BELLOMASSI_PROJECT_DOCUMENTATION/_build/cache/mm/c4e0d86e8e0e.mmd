    stock_items {
        bigserial id PK
        bigint hub_id FK
        bigint product_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }
    stock_movements {
        bigserial id PK
        bigint hub_id FK
        bigint product_id FK
